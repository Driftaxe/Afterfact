# ==============================================================================
# Afterfact Staging Environment Template (infra/staging.env.example)
#
# Copy this file to `infra/staging.env` (which is git-ignored) and populate
# with real credentials before running deployment commands or smoke tests.
# NEVER commit real tokens, secrets, or database URLs to version control.
# ==============================================================================

# Application Environment & Public Base URL
APP_ENV=staging
NODE_ENV=production
APP_BASE_URL=https://afterfact-staging.vercel.app

# ------------------------------------------------------------------------------
# Neon PostgreSQL Staging Database (Branch: afterfact-staging)
# ------------------------------------------------------------------------------
# Pooled connection string (PgBouncer, port 5432/6543) for runtime queries
DATABASE_URL=postgres://user:password@ep-staging-pooler.us-east-2.aws.neon.tech/afterfact?sslmode=require&pgbouncer=true

# Direct unpooled connection string (port 5432) for Prisma DDL migrations
DIRECT_URL=postgres://user:password@ep-staging.us-east-2.aws.neon.tech/afterfact?sslmode=require

# ------------------------------------------------------------------------------
# Bifrost Model Gateway (Hosted on Railway)
# ------------------------------------------------------------------------------
BIFROST_BASE_URL=https://bifrost-staging.up.railway.app
BIFROST_GATEWAY_TOKEN=bf_gw_sample_staging_token
BIFROST_EXTRACT_MODEL=openai/gpt-4o-mini
BIFROST_ASSESS_MODEL=anthropic/claude-3-5-sonnet-20241022
BIFROST_DRAFT_MODEL=openai/gpt-4o
BIFROST_ASSESS_FALLBACK=groq/llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Web Retrieval — Tavily Search
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-sample_staging_key

# ------------------------------------------------------------------------------
# Queue & Webhook Verification — Upstash QStash
# ------------------------------------------------------------------------------
QSTASH_TOKEN=qstash_sample_staging_token
QSTASH_CURRENT_SIGNING_KEY=sig_sample_staging_curr
QSTASH_NEXT_SIGNING_KEY=sig_sample_staging_next

# ------------------------------------------------------------------------------
# Internal Security & Vercel Bypass
# ------------------------------------------------------------------------------
INTERNAL_CRON_SECRET=sample_internal_cron_secret
VERCEL_PROTECTION_BYPASS=sample_vercel_protection_bypass_secret
