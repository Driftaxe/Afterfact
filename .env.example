# ==============================================================================
# Afterfact — Environment Variables Baseline (.env.example)
# Do not commit real credentials. Copy to .env.local for development.
# ==============================================================================

# Public Application Base URL
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Neon PostgreSQL Connection Strings — Prisma ORM (Required for Task B04+)
# ------------------------------------------------------------------------------
# Pooled connection string (PgBouncer) for serverless application runtime queries
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/afterfact?sslmode=require&pgbouncer=true

# Direct unpooled connection string (port 5432) for Prisma DDL migrations
DIRECT_URL=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/afterfact?sslmode=require

# Dedicated test database branch connections for automated integration tests
TEST_DATABASE_URL=postgres://user:password@ep-sample-test-pooler.us-east-2.aws.neon.tech/afterfact_test?sslmode=require&pgbouncer=true
TEST_DIRECT_URL=postgres://user:password@ep-sample-test.us-east-2.aws.neon.tech/afterfact_test?sslmode=require

# ------------------------------------------------------------------------------
# Web Intelligence Retrieval (Required for Task B03+)
# ------------------------------------------------------------------------------
# Tavily Search & Extract API Key
TAVILY_API_KEY=tvly-sample-api-key

# ------------------------------------------------------------------------------
# Model Gateway — Bifrost (Required for Task B02+)
# ------------------------------------------------------------------------------
BIFROST_BASE_URL=http://127.0.0.1:8080
BIFROST_SETUP_TOKEN=bf_setup_sample_token
BIFROST_GATEWAY_TOKEN=bf_gw_sample_token
BIFROST_EXTRACT_MODEL=gemini-3.5-flash-lite
BIFROST_ASSESS_MODEL=gemini-3.5-flash-lite
BIFROST_DRAFT_MODEL=gemini-3.5-flash-lite
BIFROST_ASSESS_FALLBACK=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# Queue & Webhook Delivery — Upstash QStash (Required for Task B05+)
# ------------------------------------------------------------------------------
QSTASH_TOKEN=qstash_sample_token
QSTASH_CURRENT_SIGNING_KEY=sig_sample_current_key
QSTASH_NEXT_SIGNING_KEY=sig_sample_next_key
