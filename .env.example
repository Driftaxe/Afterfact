# ==============================================================================
# Afterfact — Environment Variables Baseline (.env.example)
# Do not commit real credentials. Copy to .env.local for development.
# ==============================================================================

# Public Application Base URL
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Neon PostgreSQL Connection Strings (Required for Task B04+)
# ------------------------------------------------------------------------------
# Pooled connection string (PgBouncer) for serverless application runtime
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/afterfact?sslmode=require

# Direct connection string for Drizzle DDL schema migrations
DATABASE_MIGRATION_URL=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/afterfact?sslmode=require

# ------------------------------------------------------------------------------
# Web Intelligence Retrieval (Required for Task B03+)
# ------------------------------------------------------------------------------
# Tavily Search & Extract API Key
TAVILY_API_KEY=tvly-sample-api-key

# ------------------------------------------------------------------------------
# Model Gateway — Bifrost (Required for Task B02+)
# ------------------------------------------------------------------------------
BIFROST_BASE_URL=http://127.0.0.1:8080
BIFROST_GATEWAY_TOKEN=bf_gw_sample_token
BIFROST_EXTRACT_MODEL=openai/gpt-4o-mini
BIFROST_ASSESS_MODEL=anthropic/claude-3-5-sonnet-20241022
BIFROST_DRAFT_MODEL=openai/gpt-4o
BIFROST_ASSESS_FALLBACK=groq/llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Queue & Webhook Delivery — Upstash QStash (Required for Task B05+)
# ------------------------------------------------------------------------------
QSTASH_TOKEN=qstash_sample_token
QSTASH_CURRENT_SIGNING_KEY=sig_sample_current_key
QSTASH_NEXT_SIGNING_KEY=sig_sample_next_key
