{
  "name": "afterfact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "bifrost": "dotenv -e .env -- pnpm dlx @maximhq/bifrost",
    "smoke:bifrost": "node --import tsx/esm infra/smoke-bifrost.ts",
    "smoke:extract": "node --import tsx/esm infra/test-live-extraction.ts",
    "smoke:staging": "node --import tsx/esm infra/smoke-staging.ts",
    "db:migrate": "dotenv run -f .env.local -- prisma migrate dev",
    "db:generate": "dotenv run -f .env.local -- prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tavily/core": "^1.0.0",
    "@upstash/qstash": "^2.12.1",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.29",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.0"
  }
}
