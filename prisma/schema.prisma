datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model VerificationRun {
  id             String    @id @default(cuid()) @db.VarChar(36)
  ownerHash      String    @db.VarChar(64)
  inputHash      String    @db.VarChar(64)
  prepId         String?   @db.VarChar(36)
  idempotencyKey String?   @db.VarChar(64)
  mode           String    @db.VarChar(16)
  text           String    @db.Text
  question       String?   @db.Text
  context        Json      @db.JsonB
  parentRunId    String?   @db.VarChar(36)
  state          String    @db.VarChar(16)
  graphVersion   Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  finishedAt     DateTime? @db.Timestamptz
  expiresAt      DateTime  @db.Timestamptz
  nextEventSeq   Int       @default(1)

  preparation    Preparation?    @relation(fields: [prepId], references: [id], onDelete: SetNull)
  claims         Claim[]
  sourceDocs     SourceDocument[]
  events         RunEvent[]
  dagNodes       DagNode[]
  dagEdges       DagEdge[]
  clarifications Clarification[]

  @@unique([ownerHash, idempotencyKey])
  @@index([ownerHash, createdAt])
  @@index([expiresAt])
  @@map("runs")
}

model Preparation {
  id             String   @id @default(cuid()) @db.VarChar(36)
  inputHash      String   @unique @db.VarChar(64)
  normalizedText String   @db.Text
  claimTickets   Json     @db.JsonB
  qualifiers     Json     @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz

  runs           VerificationRun[]

  @@map("preparations")
}

model Claim {
  id             String   @id @default(cuid()) @db.VarChar(36)
  runId          String   @db.VarChar(36)
  text           String   @db.Text
  normalizedText String   @db.Text
  qualifiers     Json?    @db.JsonB
  status         String   @default("PENDING") @db.VarChar(24)
  createdAt      DateTime @default(now()) @db.Timestamptz

  run            VerificationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  assessments    ClaimEvidenceAssessment[]
  decision       DecisionRecord?
  clarifications Clarification[]

  @@index([runId])
  @@map("claims")
}

model SourceDocument {
  id         String   @id @default(cuid()) @db.VarChar(36)
  runId      String   @db.VarChar(36)
  url        String   @db.Text
  title      String?  @db.Text
  domain     String?  @db.VarChar(255)
  rawContent String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz

  run           VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidenceUnits EvidenceUnit[]

  @@index([runId])
  @@map("source_documents")
}

model EvidenceUnit {
  id          String   @id @default(cuid()) @db.VarChar(36)
  sourceDocId String   @db.VarChar(36)
  content     String   @db.Text
  quote       String?  @db.Text
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz

  sourceDoc   SourceDocument            @relation(fields: [sourceDocId], references: [id], onDelete: Cascade)
  assessments ClaimEvidenceAssessment[]

  @@index([sourceDocId])
  @@map("evidence_units")
}

model ClaimEvidenceAssessment {
  id             String   @id @default(cuid()) @db.VarChar(36)
  claimId        String   @db.VarChar(36)
  evidenceUnitId String   @db.VarChar(36)
  stance         String   @db.VarChar(24)
  confidence     Float
  rationale      String   @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz

  claim        Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceUnit EvidenceUnit @relation(fields: [evidenceUnitId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceUnitId])
  @@map("claim_evidence_assessments")
}

model DecisionRecord {
  id         String   @id @default(cuid()) @db.VarChar(36)
  claimId    String   @unique @db.VarChar(36)
  verdict    String   @db.VarChar(32)
  confidence Float
  summary    String   @db.Text
  reasoning  Json     @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz

  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("decision_records")
}

model RunEvent {
  id        String   @id @default(cuid()) @db.VarChar(36)
  runId     String   @db.VarChar(36)
  seq       Int
  type      String   @db.VarChar(48)
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz

  run       VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("run_events")
}

model DagNode {
  id             String    @id @default(cuid()) @db.VarChar(36)
  runId          String    @db.VarChar(36)
  nodeKey        String    @db.VarChar(48)
  status         String    @default("PENDING") @db.VarChar(24)
  leaseOwner     String?   @db.VarChar(64)
  leaseExpiresAt DateTime? @db.Timestamptz
  attempt        Int       @default(0)
  input          Json?     @db.JsonB
  output         Json?     @db.JsonB
  error          String?   @db.Text
  startedAt      DateTime? @db.Timestamptz
  finishedAt     DateTime? @db.Timestamptz

  run           VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  outgoingEdges DagEdge[]       @relation("FromNode")
  incomingEdges DagEdge[]       @relation("ToNode")

  @@unique([runId, nodeKey])
  @@index([status, leaseExpiresAt])
  @@map("dag_nodes")
}

model DagEdge {
  id         String @id @default(cuid()) @db.VarChar(36)
  runId      String @db.VarChar(36)
  fromNodeId String @db.VarChar(36)
  toNodeId   String @db.VarChar(36)

  run        VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromNode   DagNode         @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode     DagNode         @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([runId, fromNodeId, toNodeId])
  @@map("dag_edges")
}

model Clarification {
  id        String   @id @default(cuid()) @db.VarChar(36)
  runId     String   @db.VarChar(36)
  claimId   String?  @db.VarChar(36)
  question  String   @db.Text
  answer    String?  @db.Text
  status    String   @default("OPEN") @db.VarChar(24)
  createdAt DateTime @default(now()) @db.Timestamptz

  run       VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  claim     Claim?          @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@map("clarifications")
}